{
  "format": "agent-crash-lab/browser-v1",
  "scenarios": [
    {
      "id": "model-retry",
      "baseline": "live-normal-naive",
      "title": "A model agent pays twice",
      "short": "Live agent retry",
      "group": "Recorded Qwen run",
      "kind": "live-model",
      "description": "Qwen proposed the purchase and answer. After a post-FINAL worker crash, a naive retry paid again.",
      "question": "Which task exceeded its authority, and did the recorded answer pass?"
    },
    {
      "id": "model-recovery",
      "baseline": "live-normal-durable",
      "title": "The same agent recovers its payment",
      "short": "Live agent recovery",
      "group": "Recorded Qwen control",
      "kind": "live-model",
      "description": "The host recovered A from its saved transaction hash. Independent same-price B still paid.",
      "question": "Did recovery preserve both the payment limit and useful work?"
    },
    {
      "id": "model-corrupt",
      "baseline": "live-corrupt-durable",
      "title": "A correct payment buys corrupted data",
      "short": "Live agent, altered data",
      "group": "Recorded Qwen control",
      "kind": "live-model",
      "description": "The local merchant served altered inventory data. Qwen proposed an answer from the delivered rows.",
      "question": "Do both the native settlement and the original data requirement pass?"
    },
    {
      "id": "proposal-wrong-answer",
      "baseline": "proposal-0-guarded",
      "title": "No overspend, but the raw answer is wrong",
      "short": "Raw model answer",
      "group": "Fresh recorded proposals",
      "kind": "model-proposals",
      "description": "Actual local Qwen output, without calculator repair. A was delivered; B was skipped. Every native payment effect here is synthetic.",
      "question": "Does staying inside the payment limit prove useful work was completed?"
    },
    {
      "id": "proposal-missing-work",
      "baseline": "proposal-3-guarded",
      "title": "One correct answer leaves a task unfinished",
      "short": "Missing independent work",
      "group": "Fresh recorded proposals",
      "kind": "model-proposals",
      "description": "The raw answer for A passed; B was not delivered. Recorded inference with synthetic payments, not a new chain run.",
      "question": "Can a partially correct run pass when another required output is missing?"
    },
    {
      "id": "proposal-independent-b",
      "baseline": "proposal-4-guarded",
      "title": "Independent B paid; A never finished",
      "short": "Independent task B",
      "group": "Fresh recorded proposals",
      "kind": "model-proposals",
      "description": "Qwen bought independent same-price B, but its recorded answer failed. A remained undelivered after a skipped retry. Payment effects are synthetic.",
      "question": "Are valid per-task payments being confused with successful completion?"
    },
    {
      "id": "async-partial-union",
      "baseline": "async-partial-union",
      "title": "Two partial views prove a budget breach",
      "short": "Partial evidence, proven excess",
      "group": "Constructed asynchronous evidence",
      "kind": "synthetic-async",
      "description": "Synthetic control: two compatible observations prove distinct finalized effects. Their union exceeds the budget; a complete total is still unknown.",
      "question": "Can proven excess survive observation order without claiming a complete history?"
    },
    {
      "id": "async-unfinalized",
      "baseline": "async-unfinalized",
      "title": "Observed success is not finalized payment",
      "short": "Unfinalized is unknown",
      "group": "Constructed asynchronous control",
      "kind": "synthetic-async",
      "description": "The same constructed receipt fragments lack matching finalized block anchors. A stays unknown; independent fully observed B remains within scope.",
      "question": "Does missing finality stay unknown while independent work remains assessable?"
    },
    {
      "id": "async-allowed",
      "baseline": "async-allowed",
      "title": "Complete evidence confirms allowed work",
      "short": "Complete, allowed control",
      "group": "Constructed asynchronous control",
      "kind": "synthetic-async",
      "description": "A constructed complete FINAL view confirms an allowed five-yoctoNEAR payment. Correct outputs and independent B both pass.",
      "question": "Does the inspector still accept genuinely complete, permitted work?"
    },
    {
      "id": "double-payment",
      "baseline": "native-naive",
      "title": "Duplicate payment after restart",
      "short": "Double payment",
      "group": "Sandbox crash replay",
      "kind": "recorded",
      "description": "A scripted worker crashes after FINAL, before acknowledgement. Retry pays A twice; equal-price B is independent.",
      "question": "Did A spend twice while both tasks succeeded?"
    },
    {
      "id": "durable-recovery",
      "baseline": "native-durable",
      "title": "Recovering a settled payment",
      "short": "Recover without repaying",
      "group": "Sandbox control replay",
      "kind": "recorded",
      "description": "After the same crash, a pre-broadcast journal recovers the known payment. Independent B still pays.",
      "question": "Can recovery finish without a second A payment?"
    },
    {
      "id": "paid-wrong-answer",
      "baseline": "merchant-utility-0",
      "title": "Paid output that failed its task",
      "short": "Paid, wrong answer",
      "group": "Useful completion",
      "kind": "recorded",
      "description": "Valid, corrupted, denied and free deliveries share an independent task reference. HTTP 200 alone is insufficient.",
      "question": "Did the recorded output satisfy its task?"
    },
    {
      "id": "legitimate-installments",
      "baseline": "split-settlement",
      "title": "An allowed split payment",
      "short": "Allowed installments",
      "group": "Negative control",
      "kind": "recorded",
      "description": "The declared budget permits split payments. Distinct hashes do not alone prove duplicate intent.",
      "question": "Are these installments within the declared budget?"
    },
    {
      "id": "failed-recovery",
      "baseline": "failed-refund",
      "title": "Refunds that did not settle",
      "short": "Failed recovery",
      "group": "Recovery",
      "kind": "recorded",
      "description": "A failed payment creates a recovery obligation. Only committed recovery to its declared destination counts.",
      "question": "Was the failed intent actually refunded?"
    },
    {
      "id": "unrelated-credit",
      "baseline": "balance-attribution",
      "title": "An unrelated credit",
      "short": "Unrelated credit",
      "group": "Causal attribution",
      "kind": "recorded",
      "description": "An unrelated same-amount credit cannot settle an owner intent. Follow native transaction and receipt identity.",
      "question": "Does this credit belong to the failed intent?"
    },
    {
      "id": "missing-evidence",
      "baseline": "intent-duplicate-0",
      "title": "An incomplete receipt record",
      "short": "Missing evidence",
      "group": "Uncertainty",
      "kind": "synthetic",
      "description": "Synthetic mutation: a B receipt body is removed. A remains breached; B becomes unknown.",
      "question": "Does missing context cause a false clean result?"
    },
    {
      "id": "terminal-output",
      "baseline": "split-settlement",
      "title": "Successful final delivery",
      "short": "Eventual completion",
      "group": "Useful completion",
      "kind": "recorded",
      "description": "An allowed intermediate 402 is separate from the final delivery and recorded answer.",
      "question": "Was the final required output correct?"
    }
  ],
